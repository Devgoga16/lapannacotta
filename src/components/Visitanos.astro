---
import { Image } from 'astro:assets';
import familia from '../assets/img/familia.jpg';
import amigas from '../assets/img/amigas.jpg';
import cafe from '../assets/img/cafe-laptop.jpg';
import miniTortaRoja from '../assets/img/mini-torta-roja.jpg';
import equipo from '../assets/img/equipo-mango.jpg';
import { NEGOCIO } from '../data/negocio';

const momentos = [
  { img: familia, alt: 'Familia compartiendo postres y té en La Pannacotta', txt: 'Para reunir a los tuyos' },
  { img: cafe, alt: 'Café y laptop en una mesa del local', txt: 'Donde tus ideas fluyen' },
  { img: miniTortaRoja, alt: 'Mini torta decorada con crema y pan de oro', txt: 'Para darte un gustito' },
  { img: amigas, alt: 'Amigas conversando con sus postres', txt: 'Buenas charlas y buenos postres' },
  { img: equipo, alt: 'Integrante del equipo con el postre Mango pasión', txt: 'Hecho por nuestro team' },
];
---
<section class="section visitanos" id="visitanos" aria-labelledby="vis-title">
  <div class="momentos" aria-label="Momentos en La Pannacotta">
    {momentos.map((m) => (
      <figure class="momento">
        <Image src={m.img} alt={m.alt} widths={[320, 560]} sizes="(max-width: 700px) 70vw, 300px" />
        <figcaption>{m.txt}</figcaption>
      </figure>
    ))}
  </div>

  <div class="container visita-grid">
    <div class="visita-info">
      <p class="eyebrow">Visítanos</p>
      <h2 id="vis-title" class="h2">Tu lugar para compartir, celebrar o simplemente estar</h2>

      <dl class="datos">
        <div>
          <dt>Dirección</dt>
          <dd>{NEGOCIO.direccion}<br /><span class="muted">{NEGOCIO.zona}</span></dd>
        </div>
        <div>
          <dt>Horario</dt>
          <dd>{NEGOCIO.horario.map((h) => <span class="horario-row"><span>{h.dias}</span><span>{h.horas}</span></span>)}</dd>
        </div>
        <div>
          <dt>Contacto</dt>
          <dd>
            WhatsApp {NEGOCIO.whatsappVisible}<br />
            <a href={`mailto:${NEGOCIO.correo}`}>{NEGOCIO.correo}</a>
          </dd>
        </div>
      </dl>

      <div class="btn-row">
        <a class="btn btn-gold" href={NEGOCIO.mapa} target="_blank" rel="noopener">Cómo llegar</a>
        <a class="btn btn-outline" href={NEGOCIO.redes.comoLlegar} target="_blank" rel="noopener">Ver video de referencia</a>
      </div>
    </div>

    <div class="mapa">
      <iframe
        title="Mapa de La Pannacotta en Comas"
        src={NEGOCIO.mapaEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>
