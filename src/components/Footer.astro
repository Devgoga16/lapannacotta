---
import { Image } from 'astro:assets';
import fresa from '../assets/img/cut/cheesecake-fresa.png';
import choco from '../assets/img/cut/torta-chocolate.png';
import { NEGOCIO, waLink, MSG_HOLA } from '../data/negocio';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/img/logo.png" alt="La Pannacotta, pastelería boutique" width="220" height="142" loading="lazy" />
      <p>Síguenos para enterarte de los postres de temporada, campañas y eventos en el local.</p>
      <div class="social">
        <a href={NEGOCIO.redes.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.3" cy="6.7" r="1.1" fill="currentColor"/></svg>
        </a>
        <a href={NEGOCIO.redes.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M14 8.5V6.8c0-.8.5-1 .9-1H17V2.3L14.2 2.3C11 2.3 10.3 4.6 10.3 6.1v2.4H8v3.6h2.3V22H14v-9.9h2.8l.4-3.6H14Z" fill="currentColor"/></svg>
        </a>
        <a href={waLink(MSG_HOLA)} target="_blank" rel="noopener" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.2c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24s8.24 3.7 8.24 8.25-3.7 8.23-8.24 8.23Z"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer-col" aria-label="Secciones">
      <h3>La web</h3>
      <a href="#favoritos">Favoritos</a>
      <a href="#carta">Carta</a>
      <a href="#encargos">Tortas por encargo</a>
      <a href="#pedir">Cómo pedir</a>
      <a href="#visitanos">Visítanos</a>
    </nav>

    <div class="footer-col">
      <h3>Horario</h3>
      {NEGOCIO.horario.map((h) => <p>{h.dias}<br /><span class="muted">{h.horas}</span></p>)}
    </div>

    <div class="footer-col">
      <h3>La Pannacotta</h3>
      <p>{NEGOCIO.direccion}<br />{NEGOCIO.zona}</p>
      <p>WhatsApp {NEGOCIO.whatsappVisible}</p>
      <p><a href={`mailto:${NEGOCIO.correo}`}>{NEGOCIO.correo}</a></p>
    </div>
  </div>

  <div class="footer-wordmark" aria-hidden="true">
    <span class="fw-text"><em>La</em> Pannacotta</span>
    <div class="fw-float fw-1"><Image src={fresa} alt="" widths={[300]} sizes="18vw" /></div>
    <div class="fw-float fw-2"><Image src={choco} alt="" widths={[260]} sizes="14vw" /></div>
  </div>

  <div class="container footer-bottom">
    <p>© {year} La Pannacotta · Pastelería artesanal en Comas, Lima Norte</p>
  </div>
</footer>
